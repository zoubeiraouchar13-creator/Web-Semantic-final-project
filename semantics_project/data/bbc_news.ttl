@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bbc: <http://www.bbc.co.uk/ontologies/news/> .

bbc:NewsItem a owl:Class ;
    rdfs:label "NewsItem" ;
    rdfs:comment "A single distinct piece of news content generated by journalists for platforms." .

bbc:Agency a owl:Class ;
    rdfs:label "NewsAgency" ;
    rdfs:comment "A company or organization that gathers news reports and distributes them." .

bbc:dateCreated a owl:DatatypeProperty ;
    rdfs:label "dateCreated" ;
    rdfs:comment "The specific date and time when the news item content was generated." .

bbc:creator a owl:ObjectProperty ;
    rdfs:label "creator" ;
    rdfs:comment "The journalist, reporter or photographer who created the asset." .
