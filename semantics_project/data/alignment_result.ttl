@prefix bbc: <http://www.bbc.co.uk/ontologies/news/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix schema: <https://schema.org/> .

schema:NewsArticle owl:equivalentClass bbc:NewsItem .

schema:Organization owl:equivalentClass bbc:Agency .

schema:author owl:equivalentProperty bbc:creator .

schema:datePublished owl:equivalentProperty bbc:dateCreated .

